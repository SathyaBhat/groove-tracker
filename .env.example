# DATABASE_URL=postgres://postgres:postgres@localhost:5432/groove_tracker
DATABASE_URL=

# The public URL that serves the PWA. Used after Discogs finishes OAuth.
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3001
PORT=3001

# Create an application at https://www.discogs.com/settings/developers
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
# A descriptive app/version string sent to Discogs with every API call.
DISCOGS_USER_AGENT=GrooveTracker/0.1

# A base64-encoded 32-byte key. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
